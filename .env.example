# ---- Required ----
# PostgreSQL connection string (Railway fills this in when you add a PostgreSQL database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketing
# A long random secret used to sign sign-in cookies (at least 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# The public web address of this app, with no slash at the end
APP_URL=https://marketing.captainglowsminigolf.com

# ---- Owner sign-in ----
ADMIN_EMAIL=owner@captainglowsminigolf.com
ADMIN_PASSWORD=choose-a-strong-password
# Set to true for ONE restart to reset the owner password to ADMIN_PASSWORD, then set back to false
ADMIN_PASSWORD_RESET=false

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=marketing@captainglowsminigolf.com
RESEND_FROM_NAME=Captain Glow
RESEND_REPLY_TO=service@captainglowsminigolf.com
RESEND_WEBHOOK_SECRET=

# ---- Text messages (Twilio) — optional ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The number customers can text you at (shown on the "Text us" button)
SMS_NUMBER=

# ---- Wave Accounting customer sync — optional ----
WAVE_API_TOKEN=
WAVE_BUSINESS_ID=

# ---- Files ----
# On Railway, mount a volume at /data and use /data/uploads
UPLOAD_DIR=./uploads
PORT=3000
